{
  "name": "goose-quicknote",
  "title": "鹅的小窗",
  "pluginName": "鹅的小窗",
  "description": "鹅的笔记 · 独立速记小窗。置顶草稿便签，快捷键展开或收起，写完可一键存进鹅的笔记。",
  "author": "Antigravity",
  "homepage": "https://github.com/eachann1024/goose-notes",
  "version": "0.0.1",
  "logo": "logo.png",
  "pluginSetting": {
    "single": true
  },
  "features": [
    {
      "code": "quicknote_new",
      "explain": "打开速记小窗记下草稿；已打开时再按快捷键收起",
      "mainHide": true,
      "cmds": [
        "速记",
        "jot",
        "小窗",
        "note"
      ]
    },
    {
      "code": "quicknote_last",
      "explain": "打开上次的速记小窗，继续未写完的草稿",
      "mainHide": true,
      "cmds": [
        "便签",
        "sticky"
      ]
    }
  ],
  "preload": "preload-quicknote.js"
}
