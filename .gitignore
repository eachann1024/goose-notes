# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager: this project uses bun — bun.lock IS committed.
# Global ~/.gitignore_global has `*.lock`, so force bun.lock back in.
!bun.lock
# Ignore lockfiles from other managers to prevent accidental drift.
pnpm-lock.yaml
package-lock.json
yarn.lock

# Dependencies
node_modules

# Build output
dist
dist-ssr
dist-quicknote/
dist-editor/
dist-electron/
dist-desktop/
default.profraw
# Vite stubs live in src/lib/vite-stubs/ (NOT src/lib/build/).
# Global ~/.gitignore_global has `build/`; a folder named build is dropped by
# electron publish and store Linux CI then fails (missing node-fs-stub.ts).
!src/lib/vite-stubs/
!src/lib/vite-stubs/*
*.local
.env
.env.*
!.env.example

