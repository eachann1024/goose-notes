{
  "name": "goose-note-app",
  "private": true,
  "version": "1.7.25",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "A local-first, Notion-style Electron desktop note-taking app built on the BlockNote block editor with built-in AI.",
  "author": "goose-note-app",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/generate-text-colors.mjs && vite",
    "build": "node scripts/generate-text-colors.mjs && node src/lib/vite-stubs/assert-present.mjs && vite build && node scripts/compile-electron.mjs && node scripts/prepare-electron-pack.mjs",
    "build:debug": "node scripts/generate-text-colors.mjs && GOOSE_DEBUG=1 vite build && GOOSE_DEBUG=1 node scripts/compile-electron.mjs && GOOSE_DEBUG=1 node scripts/prepare-electron-pack.mjs",
    "mac": "python3 build_mac.py",
    "mac:dev": "GOOSE_BUILD_TARGET=electron node scripts/electron-dev.mjs",
    "win": "bun run build:electron && node scripts/electron-build-win.mjs && node scripts/collect-desktop-artifacts.mjs",
    "build:win": "bun run win",
    "win:dev": "GOOSE_BUILD_TARGET=electron node scripts/electron-dev.mjs",
    "linux": "bun run build:electron && node scripts/electron-build-linux.mjs && node scripts/collect-desktop-artifacts.mjs",
    "build:linux": "bun run linux",
    "linux:dev": "GOOSE_BUILD_TARGET=electron node scripts/electron-dev.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "test:e2e": "E2E_AUTO_START=1 playwright test",
    "test:e2e:headed": "E2E_AUTO_START=1 PW_HEADED=1 playwright test",
    "test:e2e:ui": "E2E_AUTO_START=1 playwright test --ui",
    "test:e2e:report": "playwright show-report output/playwright/report",
    "test:e2e:codegen": "playwright codegen http://localhost:6001",
    "build:electron": "node scripts/generate-text-colors.mjs && GOOSE_BUILD_TARGET=electron vite build && node scripts/compile-electron.mjs && node scripts/prepare-electron-pack.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.81",
    "@ai-sdk/openai": "3.0.85",
    "@ai-sdk/openai-compatible": "2.0.48",
    "@ai-sdk/react": "^3.0.200",
    "@assistant-ui/react": "0.15.1",
    "@blocknote/core": "0.51.3",
    "@blocknote/mantine": "0.51.3",
    "@blocknote/react": "0.51.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@floating-ui/react": "0.27.19",
    "@handlewithcare/prosemirror-inputrules": "^0.1.4",
    "@heroui/react": "^3",
    "@heroui/styles": "^3",
    "@json-render/core": "0.19.0",
    "@json-render/react": "0.19.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/browser": "^10.70.0",
    "@streamdown/cjk": "^1.0.3",
    "@tanstack/react-virtual": "3.14.2",
    "@tiptap/pm": "^3.25.0",
    "@types/markdown-it": "^14.1.2",
    "ai": "6.0.195",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "code-inspector-plugin": "1.5.1",
    "date-fns": "4.4.0",
    "docx": "9.7.1",
    "dompurify": "3.3.1",
    "echarts": "6.1.0",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "lowlight": "^3.3.0",
    "lucide-react": "1.17.0",
    "markdown-it": "14.2.0",
    "mermaid": "11.15.0",
    "minisearch": "^7.2.0",
    "motion": "13.3.0",
    "pinyin-pro": "^3.28.1",
    "prettier": "3.8.3",
    "prosemirror-highlight": "^0.15.1",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.41.4",
    "react": "19.2.7",
    "react-complex-tree": "^2.6.1",
    "react-dom": "19.2.7",
    "react-resizable-panels": "^4.12.3",
    "react-router-dom": "7.16.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unplugin-auto-import": "21.0.0",
    "uuid": "14.0.0",
    "webdav": "^5.10.0",
    "yaml": "^2.9.0",
    "yet-another-react-lightbox": "3.32.0",
    "zod": "^4.3.6",
    "zustand": "5.0.14",
    "@phosphor-icons/react": "2.1.10"
  },
  "overrides": {
    "zod": "4.4.3",
    "ai": "6.0.195",
    "@ai-sdk/provider-utils": "4.0.40",
    "prosemirror-model": "1.25.9",
    "prosemirror-view": "1.41.9",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/katex": "^0.16.8",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.4.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "linkedom": "^0.18.13",
    "playwright": "1.60.0",
    "postcss": "8.5.15",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vite": "8.0.16",
    "vite-node": "^6.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26",
    "esbuild": "^0.25.0",
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.4"
  },
  "main": "dist-electron/main/index.js",
  "patchedDependencies": {
    "@blocknote/react@0.51.3": "patches/@blocknote%2Freact@0.51.3.patch"
  }
}
